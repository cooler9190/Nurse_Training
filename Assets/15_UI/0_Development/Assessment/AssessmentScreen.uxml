<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="AssessmentScreen.uss" />
    <ui:VisualElement name="assessment-screen" class="assessment-screen">
        <ui:VisualElement name="step-panel" class="assessment-panel">
            <ui:VisualElement class="assessment-header">
                <ui:Label name="step-section" text="" class="assessment-section" />
                <ui:Label name="step-progress" text="" class="assessment-progress" />
            </ui:VisualElement>
            <ui:ScrollView name="step-body" class="assessment-body">
                <ui:Label name="step-prompt" text="" class="assessment-prompt" />
                <ui:Label name="step-hint" text="" class="assessment-hint" />
                <ui:VisualElement name="step-options" class="assessment-options" />
                <ui:Label name="step-rationale" text="" class="assessment-rationale" />
            </ui:ScrollView>
            <ui:VisualElement class="assessment-footer">
                <ui:Label name="step-points" text="" class="assessment-points" />
                <ui:Button name="step-submit" text="Submit" class="assessment-button assessment-button--primary" />
                <ui:Button name="step-next" text="Next" class="assessment-button assessment-button--primary" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="results-panel" class="assessment-panel">
            <ui:Label text="Case results" class="assessment-section" />
            <ui:VisualElement name="results-star-row" class="results-star-row" />
            <ui:Label name="results-stars" text="" class="results-title" />
            <ui:Label name="results-score" text="" class="results-score" />
            <ui:ScrollView name="results-breakdown" class="assessment-body" />
            <ui:VisualElement class="assessment-footer">
                <ui:Button name="results-retry" text="Retry case" class="assessment-button" />
                <ui:Button name="results-close" text="Back to the map" class="assessment-button assessment-button--primary" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
