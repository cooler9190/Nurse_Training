.patient-interview {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    flex-direction: column;
    justify-content: space-between;
    padding: 24px;
}

.upper-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    flex-grow: 1;
    margin-bottom: 16px;
}

.portrait-frame {
    width: 360px;
    height: 480px;
    position: relative;
    overflow: hidden;
    background-color: rgba(18, 42, 58, 0.55);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgb(122, 168, 186);
}

.portrait {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-size: 100% 100%;
    background-repeat: no-repeat;
}

.portrait-hotspot {
    position: absolute;
    background-color: rgba(0, 0, 0, 0);
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
}

.portrait-hotspot--found {
    background-color: rgba(232, 244, 248, 0.12);
    border-color: rgba(232, 244, 248, 0.9);
}

.question-panel {
    width: 380px;
    max-height: 480px;
    background-color: rgba(18, 42, 58, 0.92);
    border-radius: 8px;
    padding: 16px;
    border-width: 1px;
    border-color: rgb(122, 168, 186);
}

.panel-title {
    color: rgb(232, 244, 248);
    font-size: 18px;
    -unity-font-style: bold;
    margin-bottom: 12px;
}

.question-list {
    flex-grow: 1;
}

.question-button {
    margin-bottom: 8px;
    padding: 10px 12px;
    white-space: normal;
    background-color: rgb(236, 244, 247);
    color: rgb(22, 44, 58);
    border-radius: 4px;
    border-width: 0;
    font-size: 15px;
}

.question-button:hover {
    background-color: rgb(196, 224, 232);
}

.question-button--asked {
    background-color: rgb(90, 112, 124);
    color: rgb(210, 220, 226);
}

.cue-tray {
    min-height: 108px;
    max-height: 148px;
    margin-bottom: 16px;
    background-color: rgba(18, 42, 58, 0.88);
    border-radius: 8px;
    padding: 12px 16px;
    border-width: 1px;
    border-color: rgb(122, 168, 186);
}

.cue-tray-title {
    margin-bottom: 8px;
}

.cue-list {
    flex-grow: 1;
}

.cue-card {
    width: 220px;
    margin-right: 8px;
    padding: 8px 10px;
    background-color: rgb(236, 244, 247);
    border-radius: 4px;
    flex-shrink: 0;
}

.cue-card-title {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(18, 56, 74);
    white-space: normal;
}

.cue-card-description {
    font-size: 13px;
    color: rgb(28, 40, 48);
    white-space: normal;
}

.dialogue-panel {
    min-height: 180px;
    background-color: rgba(246, 250, 252, 0.96);
    border-radius: 8px;
    padding: 16px 20px;
    border-width: 1px;
    border-color: rgb(90, 130, 148);
}

.dialogue-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}

.speaker-name {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(18, 56, 74);
}

.done-button {
    width: 96px;
    height: 32px;
    background-color: rgb(18, 72, 92);
    color: rgb(245, 250, 252);
    border-radius: 4px;
    border-width: 0;
}

.dialogue-text {
    font-size: 18px;
    color: rgb(28, 40, 48);
    white-space: normal;
    flex-grow: 1;
}
