<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="PatientInterview.uss" />
    <ui:VisualElement name="patient-interview" class="patient-interview">
        <ui:VisualElement name="upper-row" class="upper-row">
            <ui:VisualElement name="portrait-frame" class="portrait-frame">
                <ui:VisualElement name="portrait" class="portrait" />
            </ui:VisualElement>
            <ui:VisualElement name="question-panel" class="question-panel">
                <ui:Label text="Questions" class="panel-title" />
                <ui:ScrollView name="question-list" class="question-list" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="cue-bar" class="cue-bar">
            <ui:Button name="cue-inventory-button" text="Cues (0)" class="cue-inventory-button" />
            <ui:VisualElement name="abcde-bar" class="abcde-bar">
                <ui:Button name="abcde-0" text="A" class="abcde-button" />
                <ui:Button name="abcde-1" text="B" class="abcde-button" />
                <ui:Button name="abcde-2" text="C" class="abcde-button" />
                <ui:Button name="abcde-3" text="D" class="abcde-button" />
                <ui:Button name="abcde-4" text="E" class="abcde-button" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="dialogue-panel" class="dialogue-panel">
            <ui:VisualElement class="dialogue-header">
                <ui:Label name="speaker-name" text="Patient" class="speaker-name" />
                <ui:Button name="done-button" text="Done" class="done-button" />
            </ui:VisualElement>
            <ui:Label name="dialogue-text" text="" class="dialogue-text" />
        </ui:VisualElement>
        <ui:VisualElement name="patient-folder" class="patient-folder">
            <ui:VisualElement name="folder-panel" class="folder-panel">
                <ui:Label text="Patient File" class="panel-title" />
                <ui:ScrollView name="folder-content" class="folder-content" />
            </ui:VisualElement>
            <ui:Button name="folder-tab" text="File" class="folder-tab" />
        </ui:VisualElement>
        <ui:VisualElement name="cue-overlay" class="cue-overlay">
            <ui:VisualElement name="cue-window" class="cue-window">
                <ui:VisualElement class="cue-window-header">
                    <ui:Label text="Cue Cards" class="panel-title" />
                    <ui:Button name="cue-close-button" text="X" class="cue-close-button" />
                </ui:VisualElement>
                <ui:ScrollView name="cue-list" class="cue-list" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
