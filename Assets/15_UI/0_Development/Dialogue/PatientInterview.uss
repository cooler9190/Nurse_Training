.patient-interview {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    flex-direction: column;
    justify-content: space-between;
    padding: 24px;
}

.upper-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    flex-grow: 1;
    margin-bottom: 16px;
    padding-right: 40px;
}

.portrait-frame {
    width: 360px;
    height: 480px;
    position: relative;
    overflow: hidden;
    background-color: rgba(18, 42, 58, 0.55);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgb(122, 168, 186);
}

.portrait {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-size: 100% 100%;
    background-repeat: no-repeat;
}

.portrait-hotspot {
    position: absolute;
    background-color: rgba(0, 0, 0, 0);
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
}

.portrait-hotspot--found {
    background-color: rgba(232, 244, 248, 0.12);
    border-color: rgba(232, 244, 248, 0.9);
}

.question-panel {
    width: 500px;
    max-height: 480px;
    background-color: rgba(11, 96, 111, 0);
    border-radius: 8px;
    padding: 16px;
    border-width: 1px;
    border-color: rgb(122, 168, 186);
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    color: rgb(11, 96, 111);
}

.panel-title {
    color: rgb(232, 244, 248);
    font-size: 18px;
    -unity-font-style: bold;
    margin-bottom: 12px;
}

.question-list {
    flex-grow: 1;
    background-image: none;
}

.question-button {
    margin-bottom: 8px;
    padding: 10px 12px;
    white-space: normal;
    background-color: rgba(236, 244, 247, 0);
    color: rgb(22, 44, 58);
    border-radius: 4px;
    border-width: 0;
    font-size: 15px;
    background-image: url("project://database/Assets/9_Sprites/1_UI/QuestionBox.png?fileID=21300000&guid=f11126fe26a795c4990452380c007ca5&type=3#QuestionBox");
    height: 70px;
}

.question-button:hover {
    background-color: rgba(196, 224, 232, 0);
    background-image: url("project://database/Assets/9_Sprites/1_UI/QuestionBoxSelect.png?fileID=21300000&guid=649590305d6ca30488da3dcbb98301cb&type=3#QuestionBoxSelect");
}

.question-button--asked {
    background-color: rgba(90, 112, 124, 0);
    color: rgb(210, 220, 226);
    background-image: url("project://database/Assets/9_Sprites/1_UI/QuestionBoxDeselect.png?fileID=21300000&guid=eb5b3277da9f1b04c9d24e25b84dd582&type=3#QuestionBoxDeselect");
}

.cue-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
}

.abcde-bar {
    flex-direction: row;
}

.abcde-button {
    width: 70px;
    height: 70px;
    margin: 0 0 0 8px;
    padding: 0;
    background-color: rgb(11, 96, 111);
    color: rgb(245, 250, 252);
    font-size: 25px;
    -unity-font-style: bold;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgb(122, 168, 186);
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
    border-top-left-radius: 38px;
    border-top-right-radius: 38px;
    border-bottom-right-radius: 38px;
    border-bottom-left-radius: 38px;
}

.abcde-button:hover {
    background-color: rgb(53, 234, 198);
    color: rgb(0, 0, 0);
}

.abcde-button--examined {
    background-color: rgb(90, 112, 124);
    color: rgb(210, 220, 226);
}

.cue-inventory-button {
    width: 120px;
    height: 44px;
    margin: 0;
    background-color: rgb(11, 96, 111);
    color: rgb(245, 250, 252);
    font-size: 15px;
    -unity-font-style: bold;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgb(122, 168, 186);
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
}

.cue-inventory-button:hover {
    background-color: rgb(53, 234, 198);
    color: rgb(0, 0, 0);
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
}

.dialogue-panel {
    min-height: 180px;
    background-color: rgba(255, 255, 255, 0);
    border-radius: 8px;
    padding: 16px 20px;
    border-width: 1px;
    border-color: rgb(90, 130, 148);
    background-image: url("project://database/Assets/9_Sprites/1_UI/DialogueBox.png?fileID=21300000&guid=525b5044d8f101542ae01d64049f2d3f&type=3#DialogueBox");
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.dialogue-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}

.speaker-name {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(18, 56, 74);
}

.done-button {
    width: 96px;
    height: 32px;
    background-color: rgb(11, 96, 111);
    color: rgb(245, 250, 252);
    border-radius: 4px;
    border-width: 0;
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
}

.dialogue-text {
    font-size: 20px;
    color: rgb(255, 255, 255);
    white-space: normal;
    flex-grow: 1;
}

.patient-folder {
    position: absolute;
    right: 0;
    top: 120px;
    flex-direction: row;
    align-items: flex-start;
}

.folder-panel {
    width: 0;
    overflow: hidden;
    background-color: rgba(18, 42, 58, 0.96);
    border-top-left-radius: 8px;
    border-bottom-left-radius: 8px;
    border-width: 0;
    border-color: rgb(122, 168, 186);
    transition-property: width, border-width;
    transition-duration: 0.25s;
    transition-timing-function: ease-out-cubic;
}

.patient-folder--open .folder-panel {
    width: 340px;
    border-width: 1px;
}

.folder-panel .panel-title {
    width: 308px;
    flex-shrink: 0;
    margin: 16px 16px 12px 16px;
}

.folder-content {
    width: 308px;
    max-height: 420px;
    flex-shrink: 0;
    margin: 0 16px 16px 16px;
}

.folder-tab {
    width: 56px;
    height: 56px;
    margin: 0;
    padding: 0;
    background-color: rgb(11, 96, 111);
    color: rgb(245, 250, 252);
    font-size: 14px;
    -unity-font-style: bold;
    background-size: 70% 70%;
    border-radius: 8px 0 0 8px;
    border-width: 1px;
    border-right-width: 0;
    border-color: rgb(122, 168, 186);
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
}

.folder-tab:hover {
    background-color: rgb(53, 234, 198);
    color: rgb(0, 0, 0);
}

.folder-row {
    flex-direction: row;
    justify-content: space-between;
    padding: 6px 0;
    border-bottom-width: 1px;
    border-color: rgba(122, 168, 186, 0.35);
}

.folder-label {
    color: rgb(170, 200, 212);
    font-size: 14px;
    margin-right: 12px;
}

.folder-value {
    color: rgb(232, 244, 248);
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    white-space: normal;
    flex-shrink: 1;
}

.folder-value--alert {
    color: rgb(255, 120, 110);
}

.folder-section-title {
    color: rgb(170, 200, 212);
    font-size: 14px;
    margin-top: 12px;
    margin-bottom: 4px;
}

.folder-note {
    color: rgb(232, 244, 248);
    font-size: 14px;
    white-space: normal;
    margin-bottom: 4px;
}
