.hypothesis-screen {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    padding: 24px;
    background-color: rgb(12, 30, 42);
}

.hypothesis-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
}

.header-actions {
    flex-direction: row;
    align-items: center;
}

.header-actions > .hypothesis-button {
    margin-left: 8px;
}

.hypothesis-button--wide {
    width: 190px;
}

.hypothesis-title {
    color: rgb(232, 244, 248);
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    align-items: stretch;
}

.hypothesis-button {
    width: 120px;
    height: 44px;
    margin: 0;
    background-color: rgb(3, 113, 127);
    color: rgb(245, 250, 252);
    font-size: 15px;
    -unity-font-style: bold;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgb(122, 168, 186);
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
}

.hypothesis-button:hover {
    background-color: rgb(50, 255, 215);
    color: rgb(0, 0, 0);
}

.hypothesis-button--primary {
    background-color: rgb(32, 120, 96);
}

.hypothesis-button--primary:hover {
    background-color: rgb(44, 255, 143);
}

.hypothesis-button:disabled {
    opacity: 0.45;
}

.hypothesis-body {
    flex-grow: 1;
    flex-direction: row;
    margin-bottom: 270px;
}

.hypothesis-half {
    flex-grow: 1;
    flex-basis: 0;
    padding: 16px;
    background-color: rgba(18, 42, 58, 0.92);
    border-radius: 8px;
    border-width: 2px;
    border-color: rgb(122, 168, 186);
}

.ranking-zone {
    margin-right: 12px;
    background-color: rgba(0, 42, 49, 0.588);
    border-left-color: rgb(16, 32, 30);
    border-right-color: rgb(16, 32, 30);
    border-top-color: rgb(16, 32, 30);
    border-bottom-color: rgb(16, 32, 30);
}

.diagnosis-zone {
    margin-left: 12px;
    background-color: rgba(0, 43, 50, 0.588);
    border-left-color: rgb(16, 32, 30);
    border-right-color: rgb(16, 32, 30);
    border-top-color: rgb(16, 32, 30);
    border-bottom-color: rgb(16, 32, 30);
}

.ranking-zone--drop-target {
    border-color: rgb(255, 210, 90);
    background-color: rgba(40, 64, 80, 0.95);
}

.hypothesis-panel-title {
    color: rgb(232, 244, 248);
    font-size: 18px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.hypothesis-hint {
    color: rgb(170, 200, 212);
    font-size: 14px;
    white-space: normal;
    margin-bottom: 12px;
}

.ranking-list,
.diagnosis-list {
    flex-grow: 1;
}

.hand {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 12px;
    height: 260px;
}

.drag-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.cue-card {
    padding: 10px;
    background-color: rgb(236, 244, 247);
    border-radius: 6px;
    border-width: 2px;
    border-color: rgb(122, 168, 186);
    flex-shrink: 0;
}

.cue-card--in-hand {
    position: absolute;
    width: 170px;
    height: 230px;
    overflow: hidden;
    translate: -50% 0;
    transform-origin: 50% 100%;
    transition-property: scale, translate, rotate, top, margin-left;
    transition-duration: 0.15s;
    transition-timing-function: ease-out-cubic;
}

.cue-card--hovered {
    scale: 1.5 1.5;
    border-color: rgb(255, 210, 90);
    border-left-color: rgb(53, 234, 198);
    border-right-color: rgb(53, 234, 198);
    border-top-color: rgb(53, 234, 198);
    border-bottom-color: rgb(53, 234, 198);
}

.cue-card--ranked {
    margin-bottom: 8px;
}

.cue-card--dragging {
    opacity: 0.3;
}

.cue-card--ghost {
    position: absolute;
    width: 200px;
    translate: -50% -50%;
    rotate: 3deg;
    opacity: 0.95;
    border-color: rgb(255, 210, 90);
}

.cue-card-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.cue-card-rank {
    min-width: 26px;
    height: 26px;
    margin-right: 8px;
    padding: 0 6px;
    background-color: rgb(18, 56, 74);
    color: rgb(245, 250, 252);
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-radius: 13px;
}

.cue-card-origin {
    margin-left: auto;
    padding: 2px 6px;
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(245, 250, 252);
    border-radius: 4px;
}

.cue-card-origin--question {
    background-color: rgb(30, 110, 150);
}

.cue-card-origin--visual {
    background-color: rgb(120, 76, 160);
}

.cue-card-origin--examination {
    background-color: rgb(196, 110, 36);
}

.cue-card-title {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(18, 56, 74);
    white-space: normal;
    margin-bottom: 4px;
}

.cue-card-description {
    font-size: 13px;
    color: rgb(28, 40, 48);
    white-space: normal;
    margin-bottom: 6px;
}

.cue-card-source {
    font-size: 11px;
    -unity-font-style: italic;
    color: rgb(80, 104, 116);
    white-space: normal;
}

.diagnosis-card {
    margin-bottom: 10px;
    padding: 12px;
    background-color: rgb(246, 250, 252);
    border-radius: 6px;
    border-left-width: 6px;
    border-color: rgb(196, 64, 56);
    flex-shrink: 0;
}

.diagnosis-card-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.diagnosis-card-priority {
    margin-right: 10px;
    padding: 3px 8px;
    background-color: rgb(196, 64, 56);
    color: rgb(255, 255, 255);
    font-size: 13px;
    -unity-font-style: bold;
    border-radius: 4px;
}

.diagnosis-card-title {
    flex-shrink: 1;
    font-size: 17px;
    -unity-font-style: bold;
    color: rgb(18, 56, 74);
    white-space: normal;
}

.diagnosis-card-heading {
    margin-top: 4px;
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(80, 104, 116);
}

.diagnosis-card-text {
    font-size: 14px;
    color: rgb(28, 40, 48);
    white-space: normal;
    margin-bottom: 4px;
}

.diagnosis-card-based-on {
    margin-top: 6px;
    font-size: 12px;
    -unity-font-style: italic;
    color: rgb(80, 104, 116);
    white-space: normal;
}

.diagnosis-card--in-hand {
    position: absolute;
    width: 200px;
    height: 160px;
    overflow: hidden;
    translate: -50% 0;
    transform-origin: 50% 100%;
    transition-property: rotate, top, margin-left;
    transition-duration: 0.15s;
    transition-timing-function: ease-out-cubic;
}

.diagnosis-card--hovered {
    border-color: rgb(255, 210, 90);
}

.diagnosis-card--dragging {
    opacity: 0.3;
}

.diagnosis-card--ghost {
    position: absolute;
    width: 200px;
    height: 160px;
    translate: -50% -50%;
    rotate: 3deg;
    opacity: 0.95;
    border-color: rgb(255, 210, 90);
    transition-duration: 0s;
}

.diagnosis-card-badge {
    margin-top: 8px;
    padding: 3px 8px;
    align-self: flex-start;
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    background-color: rgb(120, 130, 140);
    border-radius: 4px;
}

.diagnosis-card--shared .diagnosis-card-badge {
    background-color: rgb(32, 120, 96);
}

.patient-drop {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.patient-portrait {
    width: 280px;
    height: 420px;
    margin-top: 8px;
    margin-bottom: 8px;
    background-color: rgba(18, 42, 58, 0.5);
    border-width: 3px;
    border-color: rgb(122, 168, 186);
    border-radius: 8px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}

.patient-drop--target .patient-portrait {
    border-color: rgb(255, 210, 90);
}

.share-hint {
    max-width: 520px;
    -unity-text-align: middle-center;
}

.share-dialogue {
    position: absolute;
    left: 80px;
    right: 80px;
    top: 100px;
    bottom: 290px;
    padding: 20px 24px;
    flex-direction: column;
    background-color: rgb(246, 250, 252);
    border-radius: 8px;
    border-width: 2px;
    border-color: rgb(122, 168, 186);
}

.share-stage {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(18, 56, 74);
}

.share-purpose {
    font-size: 14px;
    color: rgb(80, 104, 116);
    white-space: normal;
    margin-bottom: 8px;
}

.share-scroll {
    flex-grow: 1;
    min-height: 0;
}

.share-introduction {
    font-size: 15px;
    color: rgb(28, 40, 48);
    white-space: normal;
    margin-bottom: 8px;
}

.share-option {
    margin-top: 8px;
    padding: 8px 10px;
    background-color: rgb(232, 244, 248);
    border-radius: 4px;
}

.share-option-title {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(18, 56, 74);
    white-space: normal;
}

.share-option-text {
    font-size: 13px;
    color: rgb(28, 40, 48);
    white-space: normal;
}

.share-choice {
    margin-top: 8px;
    padding: 8px 12px;
    white-space: normal;
    height: auto;
    min-height: 40px;
    background-color: rgb(3, 113, 127);
    color: rgb(245, 250, 252);
    border-radius: 4px;
    -unity-text-align: middle-left;
}

.share-choice:hover {
    background-color: rgb(50, 255, 215);
    color: rgb(0, 0, 0);
}

.share-spoken {
    margin-top: 12px;
    font-size: 15px;
    color: rgb(18, 56, 74);
    white-space: normal;
}

.share-actions {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 12px;
}

.share-actions > .hypothesis-button {
    margin-left: 8px;
}
