.assessment-screen {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    padding: 24px;
    justify-content: center;
    align-items: center;
    background-color: rgb(12, 30, 42);
}

.assessment-panel {
    width: 80%;
    max-width: 1100px;
    max-height: 100%;
    padding: 24px;
    background-color: rgba(18, 42, 58, 0.98);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgb(122, 168, 186);
}

.assessment-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
}

.assessment-section {
    color: rgb(232, 244, 248);
    font-size: 22px;
    -unity-font-style: bold;
}

.assessment-progress {
    color: rgb(170, 200, 212);
    font-size: 16px;
}

.assessment-body {
    flex-shrink: 1;
    flex-grow: 1;
    margin-bottom: 16px;
}

.assessment-prompt {
    color: rgb(232, 244, 248);
    font-size: 18px;
    white-space: normal;
    margin-bottom: 8px;
}

.assessment-hint {
    color: rgb(170, 200, 212);
    font-size: 14px;
    margin-bottom: 12px;
}

.assessment-option {
    padding: 10px 14px;
    margin-bottom: 8px;
    background-color: rgb(236, 244, 247);
    border-radius: 4px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
}

.assessment-option:hover {
    background-color: rgb(196, 224, 232);
}

.assessment-option--selected {
    border-color: rgb(30, 130, 190);
    background-color: rgb(206, 230, 242);
}

.assessment-option--locked:hover {
    background-color: rgb(236, 244, 247);
}

.assessment-option--locked.assessment-option--selected {
    border-color: rgb(30, 130, 190);
}

.assessment-option--good {
    background-color: rgb(214, 240, 224);
}

.assessment-option--bad {
    background-color: rgb(250, 222, 218);
}

.assessment-option--neutral {
    background-color: rgb(228, 232, 235);
}

.assessment-option--locked.assessment-option--good:hover {
    background-color: rgb(214, 240, 224);
}

.assessment-option--locked.assessment-option--bad:hover {
    background-color: rgb(250, 222, 218);
}

.assessment-option-text {
    color: rgb(22, 44, 58);
    font-size: 16px;
    white-space: normal;
}

.assessment-option-points {
    position: absolute;
    right: 12px;
    top: 10px;
    color: rgb(18, 56, 74);
    font-size: 14px;
    -unity-font-style: bold;
}

.assessment-option-feedback {
    color: rgb(60, 78, 90);
    font-size: 13px;
    white-space: normal;
    margin-top: 4px;
    margin-right: 40px;
}

.assessment-rationale {
    color: rgb(232, 244, 248);
    font-size: 15px;
    white-space: normal;
    margin-top: 12px;
    padding: 10px 12px;
    background-color: rgba(122, 168, 186, 0.18);
    border-radius: 4px;
}

.assessment-footer {
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
}

.assessment-points {
    flex-grow: 1;
    color: rgb(170, 200, 212);
    font-size: 16px;
}

.assessment-button {
    width: 160px;
    height: 44px;
    margin: 0 0 0 8px;
    background-color: rgb(18, 72, 92);
    color: rgb(245, 250, 252);
    font-size: 15px;
    -unity-font-style: bold;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgb(122, 168, 186);
}

.assessment-button:hover {
    background-color: rgb(30, 96, 120);
}

.assessment-button--primary {
    background-color: rgb(32, 120, 96);
}

.assessment-button--primary:hover {
    background-color: rgb(44, 146, 118);
}

.assessment-button:disabled {
    opacity: 0.45;
}

.results-star-row {
    flex-direction: row;
    justify-content: center;
    margin: 8px 0 12px 0;
}

.result-star {
    width: 30px;
    height: 30px;
    margin: 0 14px;
    rotate: 45deg;
    background-color: rgb(70, 92, 104);
    border-radius: 4px;
}

.result-star--filled {
    background-color: rgb(244, 196, 64);
}

.results-title {
    color: rgb(232, 244, 248);
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

.results-score {
    color: rgb(170, 200, 212);
    font-size: 16px;
    -unity-text-align: middle-center;
    margin-bottom: 16px;
}

.results-line {
    margin-bottom: 10px;
}

.results-line-top {
    flex-direction: row;
    justify-content: space-between;
}

.results-line-name {
    color: rgb(232, 244, 248);
    font-size: 16px;
}

.results-line-value {
    color: rgb(232, 244, 248);
    font-size: 16px;
    -unity-font-style: bold;
}

.results-bar {
    height: 8px;
    margin-top: 4px;
    background-color: rgb(70, 92, 104);
    border-radius: 4px;
}

.results-bar-fill {
    height: 100%;
    background-color: rgb(60, 180, 130);
    border-radius: 4px;
}

.results-heading {
    color: rgb(170, 200, 212);
    font-size: 14px;
    margin-top: 16px;
    margin-bottom: 4px;
}

.results-text {
    color: rgb(232, 244, 248);
    font-size: 15px;
    white-space: normal;
}

.results-penalty {
    color: rgb(255, 150, 140);
    font-size: 14px;
    white-space: normal;
    margin-bottom: 2px;
}
